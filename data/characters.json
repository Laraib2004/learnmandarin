{
 "meta": {
  "title": "Hanzi — how characters are built",
  "why": "Characters look like random squiggles only until you learn that they are assembled from a small set of reusable parts. There are roughly 200 common components; learn about 60 and most characters become readable structures rather than pictures to memorise. The characters here are ordered by how often they appear in THIS course, so every one you learn pays off immediately: the top 100 cover about 68% of all the text in the app.",
  "license": "CC0"
 },
 "strokeRules": [
  {
   "rule": "Top to bottom",
   "eg": "三",
   "note": "The three lines of 三 (three) are written from the top down."
  },
  {
   "rule": "Left to right",
   "eg": "们",
   "note": "The person radical on the left is finished before the right side."
  },
  {
   "rule": "Horizontal before crossing vertical",
   "eg": "十",
   "note": "In 十 (ten) the horizontal comes first, then the vertical through it."
  },
  {
   "rule": "Outside before inside",
   "eg": "问",
   "note": "The doorframe of 问 (ask) is drawn before the 口 inside it."
  },
  {
   "rule": "Close the box last",
   "eg": "回",
   "note": "Draw the three sides, fill the inside, then seal the bottom."
  },
  {
   "rule": "Centre before wings",
   "eg": "小",
   "note": "In 小 (small) the middle stroke comes first, then left and right."
  },
  {
   "rule": "Left-falling before right-falling",
   "eg": "人",
   "note": "人 (person) is two strokes: the left sweep, then the right."
  },
  {
   "rule": "Dots last",
   "eg": "我",
   "note": "A finishing dot or tick is usually the final stroke."
  }
 ],
