    { "id": "s171", "unit": "u18", "hanzi": "之所以这样是因为时间不够", "pinyin": "zhī suǒyǐ zhèyàng shì yīnwèi shíjiān bú gòu", "en": "The reason it's like this is that there wasn't enough time",
      "words": [{"h":"之所以","p":"zhī suǒyǐ","e":"the reason why"},{"h":"这样","p":"zhèyàng","e":"like this"},{"h":"是因为","p":"shì yīnwèi","e":"is because"},{"h":"时间","p":"shíjiān","e":"time"},{"h":"不够","p":"bú gòu","e":"not enough"}] },
    { "id": "s172", "unit": "u18", "hanzi": "虽然很难，但是值得", "pinyin": "suīrán hěn nán, dànshì zhídé", "en": "Although it's hard, it's worth it",
      "words": [{"h":"虽然","p":"suīrán","e":"although"},{"h":"很难","p":"hěn nán","e":"difficult"},{"h":"但是","p":"dànshì","e":"but"},{"h":"值得","p":"zhídé","e":"worth it"}] },
    { "id": "s173", "unit": "u18", "hanzi": "不但便宜，而且质量好", "pinyin": "búdàn piányi, érqiě zhìliàng hǎo", "en": "Not only is it cheap, the quality is good too",
      "words": [{"h":"不但","p":"búdàn","e":"not only"},{"h":"便宜","p":"piányi","e":"cheap"},{"h":"而且","p":"érqiě","e":"moreover"},{"h":"质量好","p":"zhìliàng hǎo","e":"good quality"}] },
    { "id": "s174", "unit": "u18", "hanzi": "换句话说，我们没有别的选择", "pinyin": "huàn jù huà shuō, wǒmen méiyǒu biéde xuǎnzé", "en": "In other words, we have no other choice",
