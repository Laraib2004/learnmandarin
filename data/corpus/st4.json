    { "id": "s162", "unit": "u17", "hanzi": "我有点儿失望", "pinyin": "wǒ yǒudiǎnr shīwàng", "en": "I'm a little disappointed",
      "words": [{"h":"我","p":"wǒ","e":"I"},{"h":"有点儿","p":"yǒudiǎnr","e":"a bit (negative)"},{"h":"失望","p":"shīwàng","e":"disappointed"}] },
    { "id": "s163", "unit": "u17", "hanzi": "真是太可惜了", "pinyin": "zhēn shì tài kěxī le", "en": "What a shame",
