    { "id": "s166", "unit": "u17", "hanzi": "我压力很大", "pinyin": "wǒ yālì hěn dà", "en": "I'm under a lot of pressure",
      "words": [{"h":"我","p":"wǒ","e":"I"},{"h":"压力","p":"yālì","e":"pressure"},{"h":"很大","p":"hěn dà","e":"great, heavy"}] },
    { "id": "s167", "unit": "u17", "hanzi": "没想到会这样", "pinyin": "méi xiǎngdào huì zhèyàng", "en": "I didn't expect it to turn out like this",
      "words": [{"h":"没想到","p":"méi xiǎngdào","e":"didn't expect"},{"h":"会","p":"huì","e":"would"},{"h":"这样","p":"zhèyàng","e":"like this"}] },
    { "id": "s168", "unit": "u17", "hanzi": "我松了一口气", "pinyin": "wǒ sōng le yì kǒu qì", "en": "That's a relief",
      "words": [{"h":"我","p":"wǒ","e":"I"},{"h":"松了一口气","p":"sōng le yì kǒu qì","e":"let out a breath, felt relieved"}] },
    { "id": "s169", "unit": "u17", "hanzi": "你别放在心上", "pinyin": "nǐ bié fàng zài xīn shàng", "en": "Don't take it to heart",
      "words": [{"h":"你别","p":"nǐ bié","e":"don't"},{"h":"放在心上","p":"fàng zài xīn shàng","e":"take it to heart"}] },
    { "id": "s170", "unit": "u17", "hanzi": "我理解你的心情", "pinyin": "wǒ lǐjiě nǐ de xīnqíng", "en": "I understand how you feel",
