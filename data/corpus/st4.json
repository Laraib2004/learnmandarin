    { "id": "s178", "unit": "u18", "hanzi": "除了他，谁都不知道", "pinyin": "chúle tā, shéi dōu bù zhīdào", "en": "Apart from him, nobody knows",
      "words": [{"h":"除了","p":"chúle","e":"except"},{"h":"他","p":"tā","e":"him"},{"h":"谁都","p":"shéi dōu","e":"anyone at all"},{"h":"不知道","p":"bù zhīdào","e":"doesn't know"}] },
    { "id": "s179", "unit": "u18", "hanzi": "这跟钱没有关系", "pinyin": "zhè gēn qián méiyǒu guānxi", "en": "This has nothing to do with money",
      "words": [{"h":"这","p":"zhè","e":"this"},{"h":"跟","p":"gēn","e":"with"},{"h":"钱","p":"qián","e":"money"},{"h":"没有关系","p":"méiyǒu guānxi","e":"has no connection"}] },
