    { "id": "s246", "unit": "u25", "hanzi": "反过来说也一样", "pinyin": "fǎn guòlái shuō yě yíyàng", "en": "The same applies in reverse",
      "words": [{"h":"反过来说","p":"fǎn guòlái shuō","e":"conversely"},{"h":"也一样","p":"yě yíyàng","e":"it's the same"}] },
    { "id": "s247", "unit": "u25", "hanzi": "我们先把话说清楚", "pinyin": "wǒmen xiān bǎ huà shuō qīngchu", "en": "Let's be clear about this first",
