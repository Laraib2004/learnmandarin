  "sentences": [
    { "id": "s211", "unit": "u22", "hanzi": "我个人觉得可能不太合适", "pinyin": "wǒ gèrén juéde kěnéng bú tài héshì", "en": "Personally I feel it might not be quite suitable",
      "words": [{"h":"我个人","p":"wǒ gèrén","e":"personally"},{"h":"觉得","p":"juéde","e":"feel"},{"h":"可能","p":"kěnéng","e":"perhaps"},{"h":"不太","p":"bú tài","e":"not very"},{"h":"合适","p":"héshì","e":"suitable"}] },
    { "id": "s212", "unit": "u22", "hanzi": "这么说吧，事情比较复杂", "pinyin": "zhème shuō ba, shìqing bǐjiào fùzá", "en": "Let me put it this way — it's rather complicated",
      "words": [{"h":"这么说吧","p":"zhème shuō ba","e":"let me put it this way"},{"h":"事情","p":"shìqing","e":"the matter"},{"h":"比较","p":"bǐjiào","e":"relatively"},{"h":"复杂","p":"fùzá","e":"complicated"}] },
    { "id": "s213", "unit": "u22", "hanzi": "在某种程度上你是对的", "pinyin": "zài mǒu zhǒng chéngdù shàng nǐ shì duì de", "en": "To some extent you're right",
      "words": [{"h":"在某种程度上","p":"zài mǒu zhǒng chéngdù shàng","e":"to a certain degree"},{"h":"你是对的","p":"nǐ shì duì de","e":"you are right"}] },
    { "id": "s214", "unit": "u22", "hanzi": "恐怕没那么简单", "pinyin": "kǒngpà méi nàme jiǎndān", "en": "I'm afraid it's not that simple",
      "words": [{"h":"恐怕","p":"kǒngpà","e":"I'm afraid"},{"h":"没那么","p":"méi nàme","e":"not so"},{"h":"简单","p":"jiǎndān","e":"simple"}] },
    { "id": "s215", "unit": "u22", "hanzi": "不见得吧", "pinyin": "bú jiàndé ba", "en": "Not necessarily",
      "words": [{"h":"不见得","p":"bú jiàndé","e":"not necessarily"},{"h":"吧","p":"ba","e":"(softener)"}] },
    { "id": "s216", "unit": "u22", "hanzi": "我只是随便说说", "pinyin": "wǒ zhǐshì suíbiàn shuōshuo", "en": "I'm just thinking out loud",
      "words": [{"h":"我只是","p":"wǒ zhǐshì","e":"I'm only"},{"h":"随便","p":"suíbiàn","e":"casually"},{"h":"说说","p":"shuōshuo","e":"saying"}] },
    { "id": "s217", "unit": "u22", "hanzi": "怎么说呢，有好有坏", "pinyin": "zěnme shuō ne, yǒu hǎo yǒu huài", "en": "How should I put it — there's good and bad",
      "words": [{"h":"怎么说呢","p":"zěnme shuō ne","e":"how to put it"},{"h":"有好有坏","p":"yǒu hǎo yǒu huài","e":"there's good and bad"}] },
    { "id": "s218", "unit": "u22", "hanzi": "话是这么说，可是…", "pinyin": "huà shì zhème shuō, kěshì…", "en": "That's true in theory, but…",
      "words": [{"h":"话是这么说","p":"huà shì zhème shuō","e":"that's what people say"},{"h":"可是","p":"kěshì","e":"but"}] },
    { "id": "s219", "unit": "u22", "hanzi": "我不是那个意思", "pinyin": "wǒ bú shì nàge yìsi", "en": "That's not what I meant",
      "words": [{"h":"我不是","p":"wǒ bú shì","e":"I don't"},{"h":"那个","p":"nàge","e":"that"},{"h":"意思","p":"yìsi","e":"meaning"}] },
    { "id": "s220", "unit": "u22", "hanzi": "严格来说并不完全正确", "pinyin": "yángé lái shuō bìng bù wánquán zhèngquè", "en": "Strictly speaking, that isn't entirely correct",
      "words": [{"h":"严格来说","p":"yángé lái shuō","e":"strictly speaking"},{"h":"并不","p":"bìng bù","e":"not actually"},{"h":"完全","p":"wánquán","e":"completely"},{"h":"正确","p":"zhèngquè","e":"correct"}] },

    { "id": "s221", "unit": "u23", "hanzi": "马马虎虎", "pinyin": "mǎmǎhūhū", "en": "So-so, not great",
      "words": [{"h":"马马虎虎","p":"mǎmǎhūhū","e":"careless; so-so"}] },
    { "id": "s222", "unit": "u23", "hanzi": "入乡随俗", "pinyin": "rù xiāng suí sú", "en": "When in Rome, do as the Romans do",
      "words": [{"h":"入乡","p":"rù xiāng","e":"enter a village"},{"h":"随俗","p":"suí sú","e":"follow its customs"}] },
    { "id": "s223", "unit": "u23", "hanzi": "一举两得", "pinyin": "yì jǔ liǎng dé", "en": "Kill two birds with one stone",
      "words": [{"h":"一举","p":"yì jǔ","e":"one action"},{"h":"两得","p":"liǎng dé","e":"two gains"}] },
    { "id": "s224", "unit": "u23", "hanzi": "说曹操，曹操到", "pinyin": "shuō Cáo Cāo, Cáo Cāo dào", "en": "Speak of the devil",
      "words": [{"h":"说曹操","p":"shuō Cáo Cāo","e":"speak of Cao Cao"},{"h":"曹操到","p":"Cáo Cāo dào","e":"and Cao Cao arrives"}] },
    { "id": "s225", "unit": "u23", "hanzi": "不管三七二十一", "pinyin": "bùguǎn sān qī èrshíyī", "en": "Regardless of the consequences, just go for it",
      "words": [{"h":"不管","p":"bùguǎn","e":"regardless of"},{"h":"三七二十一","p":"sān qī èrshíyī","e":"three sevens are twenty-one (i.e. anything)"}] },
    { "id": "s226", "unit": "u23", "hanzi": "半途而废", "pinyin": "bàn tú ér fèi", "en": "To give up halfway",
      "words": [{"h":"半途","p":"bàn tú","e":"halfway"},{"h":"而废","p":"ér fèi","e":"and abandon"}] },
    { "id": "s227", "unit": "u23", "hanzi": "熟能生巧", "pinyin": "shú néng shēng qiǎo", "en": "Practice makes perfect",
      "words": [{"h":"熟","p":"shú","e":"familiarity"},{"h":"能生","p":"néng shēng","e":"produces"},{"h":"巧","p":"qiǎo","e":"skill"}] },
    { "id": "s228", "unit": "u23", "hanzi": "随便你", "pinyin": "suíbiàn nǐ", "en": "Suit yourself",
      "words": [{"h":"随便","p":"suíbiàn","e":"as you please"},{"h":"你","p":"nǐ","e":"you"}] },
    { "id": "s229", "unit": "u23", "hanzi": "差不多得了", "pinyin": "chàbuduō dé le", "en": "That's enough, knock it off",
      "words": [{"h":"差不多","p":"chàbuduō","e":"close enough"},{"h":"得了","p":"dé le","e":"that'll do"}] },
    { "id": "s230", "unit": "u23", "hanzi": "有志者事竟成", "pinyin": "yǒu zhì zhě shì jìng chéng", "en": "Where there's a will, there's a way",
      "words": [{"h":"有志者","p":"yǒu zhì zhě","e":"one who has will"},{"h":"事竟成","p":"shì jìng chéng","e":"will succeed in the end"}] },

    { "id": "s231", "unit": "u24", "hanzi": "您好，请问您是哪位？", "pinyin": "nín hǎo, qǐngwèn nín shì nǎ wèi?", "en": "Hello, may I ask who's calling?",
      "words": [{"h":"您好","p":"nín hǎo","e":"hello (polite)"},{"h":"请问","p":"qǐngwèn","e":"may I ask"},{"h":"您是哪位","p":"nín shì nǎ wèi","e":"who are you (polite)"}] },
    { "id": "s232", "unit": "u24", "hanzi": "麻烦您稍等一下", "pinyin": "máfan nín shāo děng yíxià", "en": "Please hold for a moment",
      "words": [{"h":"麻烦您","p":"máfan nín","e":"may I trouble you"},{"h":"稍等","p":"shāo děng","e":"wait briefly"},{"h":"一下","p":"yíxià","e":"a moment"}] },
    { "id": "s233", "unit": "u24", "hanzi": "感谢您的支持", "pinyin": "gǎnxiè nín de zhīchí", "en": "Thank you for your support",
      "words": [{"h":"感谢","p":"gǎnxiè","e":"thank (formal)"},{"h":"您的","p":"nín de","e":"your"},{"h":"支持","p":"zhīchí","e":"support"}] },
    { "id": "s234", "unit": "u24", "hanzi": "期待您的回复", "pinyin": "qīdài nín de huífù", "en": "I look forward to your reply",
      "words": [{"h":"期待","p":"qīdài","e":"look forward to"},{"h":"您的","p":"nín de","e":"your"},{"h":"回复","p":"huífù","e":"reply"}] },
    { "id": "s235", "unit": "u24", "hanzi": "关于这个问题，我想补充一点", "pinyin": "guānyú zhège wèntí, wǒ xiǎng bǔchōng yì diǎn", "en": "On this point, I'd like to add something",
