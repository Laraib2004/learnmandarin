    { "id": "s239", "unit": "u24", "hanzi": "时间关系，我们先到这里", "pinyin": "shíjiān guānxi, wǒmen xiān dào zhèlǐ", "en": "In the interest of time, let's stop here",
      "words": [{"h":"时间关系","p":"shíjiān guānxi","e":"due to time"},{"h":"我们","p":"wǒmen","e":"we"},{"h":"先到这里","p":"xiān dào zhèlǐ","e":"stop here for now"}] },
    { "id": "s240", "unit": "u24", "hanzi": "辛苦了", "pinyin": "xīnkǔ le", "en": "Thanks for your hard work",
      "words": [{"h":"辛苦","p":"xīnkǔ","e":"toil, hardship"},{"h":"了","p":"le","e":"(acknowledging it)"}] },

    { "id": "s241", "unit": "u25", "hanzi": "你的意思是说…对吗？", "pinyin": "nǐ de yìsi shì shuō… duì ma?", "en": "So what you mean is… is that right?",
      "words": [{"h":"你的意思","p":"nǐ de yìsi","e":"your meaning"},{"h":"是说","p":"shì shuō","e":"is that"},{"h":"对吗","p":"duì ma","e":"right?"}] },
    { "id": "s242", "unit": "u25", "hanzi": "我理解你的意思，不过…", "pinyin": "wǒ lǐjiě nǐ de yìsi, búguò…", "en": "I take your point, however…",
      "words": [{"h":"我理解","p":"wǒ lǐjiě","e":"I understand"},{"h":"你的意思","p":"nǐ de yìsi","e":"your point"},{"h":"不过","p":"búguò","e":"however"}] },
    { "id": "s243", "unit": "u25", "hanzi": "确实有道理，但问题在于…", "pinyin": "quèshí yǒu dàolǐ, dàn wèntí zàiyú…", "en": "That's fair, but the problem is…",
