    { "id": "u3", "title": "Want, order, pay", "goal": "Get food, drink, and a price. The highest-value beginner unit." },
    { "id": "u4", "title": "Where and when", "goal": "Find places, tell time, make plans." },
    { "id": "u5", "title": "Join ideas together", "goal": "Stop speaking in fragments: because / so / but / I think." },
    { "id": "u6", "title": "Hold a real exchange", "goal": "A full small-talk conversation about learning Chinese." }
