  "rules": [
    { "id": "t3t3", "title": "Third + third → second + third",
      "detail": "When two 3rd tones collide, the first becomes a 2nd tone. 你好 is written nǐ hǎo but said ní hǎo.",
      "examples": [ { "hanzi": "你好", "written": "nǐ hǎo", "spoken": "ní hǎo" }, { "hanzi": "很好", "written": "hěn hǎo", "spoken": "hén hǎo" }, { "hanzi": "我想", "written": "wǒ xiǎng", "spoken": "wó xiǎng" } ] },
    { "id": "bu", "title": "不 bù → bú before a 4th tone",
      "detail": "不 is 4th tone, but flips to 2nd tone when the next syllable is 4th tone.",
      "examples": [ { "hanzi": "不是", "written": "bù shì", "spoken": "bú shì" }, { "hanzi": "不要", "written": "bù yào", "spoken": "bú yào" }, { "hanzi": "不客气", "written": "bù kèqi", "spoken": "bú kèqi" } ] },
    { "id": "yi", "title": "一 yī shifts by context",
      "detail": "一 is 1st tone alone, becomes yì before tones 1/2/3, and yí before a 4th tone.",
      "examples": [ { "hanzi": "一杯", "written": "yī bēi", "spoken": "yì bēi" }, { "hanzi": "一遍", "written": "yī biàn", "spoken": "yí biàn" }, { "hanzi": "一起", "written": "yī qǐ", "spoken": "yì qǐ" } ] },
    { "id": "half3", "title": "The half-third tone",
      "detail": "Before tones 1, 2, 4 or neutral, a 3rd tone only falls and stays low. It never rises back up. Rising on every 3rd tone is the most common beginner accent tell.",
      "examples": [ { "hanzi": "你说", "written": "nǐ shuō", "spoken": "nì(low) shuō" }, { "hanzi": "我去", "written": "wǒ qù", "spoken": "wò(low) qù" } ] }
  ]
}
