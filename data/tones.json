{
  "meta": {
    "title": "Tone Lab",
    "note": "Mandarin has 4 contour tones plus a neutral tone. The same syllable with a different tone is a different word. This is the single biggest reason learners are not understood, and the reason most apps fail: they never drill it."
  },
  "tones": [
    { "num": 1, "name": "First (high level)",   "mark": "ā", "contour": "55", "desc": "High and flat, like holding a note. Sung, not spoken.", "gesture": "→" },
    { "num": 2, "name": "Second (rising)",      "mark": "á", "contour": "35", "desc": "Rises like the English question 'huh?'", "gesture": "↗" },
    { "num": 3, "name": "Third (low dipping)",  "mark": "ǎ", "contour": "214", "desc": "Mostly just LOW. In real speech it rarely dips and rises fully.", "gesture": "↘↗" },
    { "num": 4, "name": "Fourth (falling)",     "mark": "à", "contour": "51", "desc": "Sharp fall, like a firm command: 'No!'", "gesture": "↘" },
    { "num": 5, "name": "Neutral (light)",      "mark": "a", "contour": "-",  "desc": "Short, weak, unstressed. Pitch borrowed from the syllable before it.", "gesture": "·" }
  ],
